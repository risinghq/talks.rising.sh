{
  "name": "slides",
  "private": true,
  "workspaces": [
    "packages/deck",
    "talks/diversidad-vegetal",
    "site",
    "worker"
  ],
  "scripts": {
    "dev": "bun run --cwd site dev",
    "build": "bun run --cwd site build",
    "typecheck": "tsc --noEmit",
    "lint:dead": "fallow audit",
    "deploy": "bun run build && bun run --cwd worker deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fallow": "^3.35.0",
    "typescript": "^7.0.2"
  }
}
